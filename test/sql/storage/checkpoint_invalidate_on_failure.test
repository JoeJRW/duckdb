# name: test/sql/storage/checkpoint_invalidate_on_failure.test
# description: A failed checkpoint invalidates the database; the next query surfaces the original cause
# group: [storage]

load __TEST_DIR__/checkpoint_invalidate_on_failure.db

statement ok
CREATE TABLE integers AS SELECT * FROM range(10000) tbl(i);

statement ok
CHECKPOINT;

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
PRAGMA wal_autocheckpoint='1TB';

statement ok
PRAGMA debug_checkpoint_abort='before_header'

statement ok
INSERT INTO integers SELECT * FROM range(10000, 20000) tbl(i);

# the checkpoint fails right before the header is written
statement error
CHECKPOINT;
----

# after a failed checkpoint the database is invalidated, and the very next query must refuse to run
# while surfacing the original checkpoint failure as the cause
statement error
SELECT COUNT(*) FROM integers;
----
database has been invalidated

# the same query also reports the original error that triggered the invalidation
statement error
SELECT COUNT(*) FROM integers;
----
Checkpoint aborted before header write

# a clean restart recovers the committed data from disk root + WAL replay
restart

query I
SELECT COUNT(*) FROM integers;
----
20000
