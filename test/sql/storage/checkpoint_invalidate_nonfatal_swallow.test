# name: test/sql/storage/checkpoint_invalidate_nonfatal_swallow.test
# description: A NON-fatal checkpoint failure on a swallow path (auto-checkpoint at commit) must still
#              invalidate the database. Without the storage-manager invalidate this failure is silently
#              swallowed and the database keeps running on half-updated in-memory state.
# group: [storage]

load __TEST_DIR__/checkpoint_invalidate_nonfatal_swallow.db

# force the synchronous commit path so the auto-checkpoint runs (and is swallowed) inside CommitTransaction
statement ok
SET enable_background_checkpoint=false;

statement ok
CREATE TABLE integers AS SELECT * FROM range(10000) tbl(i);

statement ok
CHECKPOINT;

statement ok
PRAGMA disable_checkpoint_on_shutdown;

# low threshold so the next commit triggers an automatic checkpoint
statement ok
PRAGMA wal_autocheckpoint='4KB';

statement ok
PRAGMA debug_checkpoint_abort='before_header_nonfatal'

# the INSERT commits fine (its data is durable in the WAL); the auto-checkpoint fires at commit,
# throws a non-fatal exception, and is swallowed by the sync-commit path -- so the statement succeeds
statement ok
INSERT INTO integers SELECT * FROM range(10000, 20000) tbl(i);

# WITH the fix: the swallowed checkpoint failure has invalidated the database, so the next query refuses
# to run. WITHOUT the fix this query would succeed while running on corrupted in-memory state.
statement error
SELECT COUNT(*) FROM integers;
----
database has been invalidated

# a clean restart recovers the committed data from disk root + WAL replay
restart

query I
SELECT COUNT(*) FROM integers;
----
20000
