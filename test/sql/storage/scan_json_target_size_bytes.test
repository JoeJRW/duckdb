# name: test/sql/storage/scan_json_target_size_bytes.test
# description: JSON scan budgets cover full values, extraction, filters, mutations, indexes and ALTER
# group: [storage]

require json

require noforcestorage

load __TEST_DIR__/scan_json_target_size_bytes.db

statement ok
SET threads=1

statement ok
SET checkpoint_threshold='1TB'

foreach compression auto uncompressed

statement ok
SET force_compression='${compression}'

foreach budget 0 1 257 65536

statement ok
SET GLOBAL scan_target_size_bytes=${budget}

statement ok
CREATE TABLE json_rows AS SELECT i, concat('{"id":', i, ',"payload":"', repeat('x', CASE WHEN i % 7 = 0 THEN 4000 ELSE 73 END), '","nested":{"ok":true},"items":[1,null,3]}')::JSON AS j FROM range(4103) tbl(i)

query I
SELECT type FROM pragma_table_info('json_rows') WHERE name='j'
----
JSON

statement ok
CHECKPOINT

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging(level='trace')

query I
SELECT count(*) FROM json_rows WHERE j::VARCHAR = concat('{"id":', i, ',"payload":"', repeat('x', CASE WHEN i % 7 = 0 THEN 4000 ELSE 73 END), '","nested":{"ok":true},"items":[1,null,3]}')
----
4103

statement ok
SET enable_logging=false

query I
SELECT (count(*) > 0) = (${budget} > 0) FROM duckdb_logs WHERE message.starts_with('ScanSizePredictor batch:')
----
true

query I
SELECT count(*) FROM duckdb_logs WHERE message.starts_with('ScanSizePredictor batch:') AND (message.split('worst_bpr=')[2].split(' ')[1]::DOUBLE <= 256 OR message.split('target_bytes=')[2].split(' ')[1]::UBIGINT <> ${budget} OR (message.split('scan_count=')[2]::BIGINT > 1 AND message.split('scan_count=')[2]::BIGINT * message.split('worst_bpr=')[2].split(' ')[1]::DOUBLE > ${budget}))
----
0

query I
SELECT count(*) FROM json_rows WHERE i BETWEEN 85 AND 4099 AND json_extract_string(j, '$.id')::BIGINT = i AND json_extract_string(j, '$.nested.ok') = 'true'
----
4015

query I
SELECT count(*) FROM json_rows WHERE length(json_extract_string(j, '$.payload')) = CASE WHEN i % 7 = 0 THEN 4000 ELSE 73 END AND json_array_length(j, '$.items') = 3
----
4103

statement ok
BEGIN TRANSACTION

statement ok
DELETE FROM json_rows WHERE i % 17 = 0

statement ok
UPDATE json_rows SET j=concat('{"id":', i, ',"payload":"', repeat('y', 3073), '"}')::JSON WHERE i % 19 = 0

query I
SELECT count(*) FROM json_rows WHERE json_extract_string(j, '$.id')::BIGINT = i AND length(json_extract_string(j, '$.payload')) = CASE WHEN i % 19 = 0 THEN 3073 WHEN i % 7 = 0 THEN 4000 ELSE 73 END
----
3861

statement ok
INSERT INTO json_rows SELECT i, concat('{"id":', i, ',"payload":"local"}')::JSON FROM range(4103, 4174) tbl(i)

query I
SELECT count(*) FROM json_rows WHERE i >= 4103 AND json_extract_string(j, '$.payload') = 'local'
----
71

statement ok
ROLLBACK

query I
SELECT count(*) FROM json_rows WHERE json_extract_string(j, '$.id')::BIGINT = i AND length(json_extract_string(j, '$.payload')) = CASE WHEN i % 7 = 0 THEN 4000 ELSE 73 END
----
4103

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging(level='trace')

statement ok
CREATE INDEX json_value_idx ON json_rows(j)

statement ok
SET enable_logging=false

query I
SELECT (count(*) > 0) = (${budget} > 0) FROM duckdb_logs WHERE message.starts_with('ScanSizePredictor batch:')
----
true

query I
SELECT i FROM json_rows WHERE j=concat('{"id":10,"payload":"', repeat('x', 73), '","nested":{"ok":true},"items":[1,null,3]}')::JSON
----
10

statement ok
DROP INDEX json_value_idx

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging(level='trace')

statement ok
ALTER TABLE json_rows ALTER COLUMN j SET NOT NULL

statement ok
SET enable_logging=false

query I
SELECT (count(*) > 0) = (${budget} > 0) FROM duckdb_logs WHERE message.starts_with('ScanSizePredictor batch:')
----
true

statement error
INSERT INTO json_rows VALUES (9999, NULL)
----
NOT NULL constraint failed

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging(level='trace')

statement ok
ALTER TABLE json_rows ALTER COLUMN j SET DATA TYPE VARCHAR

statement ok
SET enable_logging=false

query I
SELECT (count(*) > 0) = (${budget} > 0) FROM duckdb_logs WHERE message.starts_with('ScanSizePredictor batch:')
----
true

statement ok
ALTER TABLE json_rows ALTER COLUMN j SET DATA TYPE JSON

query I
SELECT count(*) FROM json_rows WHERE json_extract_string(j, '$.id')::BIGINT = i
----
4103

statement ok
DROP TABLE json_rows

endloop

endloop

statement ok
SET GLOBAL scan_target_size_bytes=1

statement ok
CREATE TABLE json_nulls(j JSON)

statement ok
INSERT INTO json_nulls VALUES (NULL), ('null'), ('{"a":null}'), ('[1,null,{"b":[2]}]'), ('"中文\\nvalue"')

query III
SELECT count(*), count(j), count(*) FILTER (WHERE j::VARCHAR='null') FROM json_nulls
----
5	4	1

statement ok
SET GLOBAL scan_target_size_bytes=1024

statement ok
CREATE TABLE native_nested_json AS SELECT {'j': j} AS s, [j] AS l, [j]::JSON[1] AS a, map(['j'], [j]) AS m FROM (SELECT concat('{"payload":"', repeat('x', 4000), '"}')::JSON AS j FROM range(128)) values_json

foreach column s l a m

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging(level='trace')

query I
SELECT sum(length(${column}::VARCHAR)) > 0 FROM native_nested_json
----
true

statement ok
SET enable_logging=false

query I
SELECT count(*) > 0 AND bool_and(message.split('worst_bpr=')[2].split(' ')[1]::DOUBLE = 256) FROM duckdb_logs WHERE message.starts_with('ScanSizePredictor batch:')
----
true

endloop

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging(level='trace')

query I
SELECT sum(length(json_extract_string(s.j, '$.payload'))) FROM native_nested_json
----
512000

statement ok
SET enable_logging=false

query I
SELECT count(*) > 0 AND bool_and(message.split('worst_bpr=')[2].split(' ')[1]::DOUBLE > 4000) FROM duckdb_logs WHERE message.starts_with('ScanSizePredictor batch:')
----
true

statement error
ALTER TABLE json_nulls ALTER COLUMN j SET NOT NULL
----
NOT NULL constraint failed

statement error
INSERT INTO json_nulls VALUES ('{invalid json}')
----
Malformed JSON

statement ok
CHECKPOINT

restart

query III
SELECT count(*), count(j), count(*) FILTER (WHERE j::VARCHAR='null') FROM json_nulls
----
5	4	1
