# name: test/sql/storage/scan_geometry_statistics.test
# description: Byte-budgeted scans must not interpret GEOMETRY_STATS as STRING_STATS
# group: [storage]

require noforcestorage

load __TEST_DIR__/scan_geometry_statistics.db readwrite v1.5.0

statement ok
SET threads=1

statement ok
SET checkpoint_threshold='1TB'

statement ok
CREATE TABLE geometries AS
SELECT i, geom, geom::VARCHAR AS expected FROM (
    SELECT i, concat('POINT(', i::VARCHAR, ' ', i::VARCHAR, ')')::GEOMETRY AS geom
    FROM range(4096) tbl(i)
)

statement ok
SET GLOBAL scan_target_size_bytes=1024

query I
SELECT count(*) FROM geometries WHERE geom::VARCHAR = expected
----
4096

statement ok
SET GLOBAL scan_target_size_bytes=1024

statement ok
CHECKPOINT

query I
SELECT count(*) FROM geometries WHERE geom::VARCHAR = expected
----
4096

restart

statement ok
SET GLOBAL scan_target_size_bytes=1024

query I
SELECT count(*) FROM geometries WHERE geom::VARCHAR = expected
----
4096
