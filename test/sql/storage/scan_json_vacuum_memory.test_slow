# name: test/sql/storage/scan_json_vacuum_memory.test_slow
# description: JSON vacuum reads fail without a budget and succeed with a global byte budget
# group: [storage]

require json

require noforcestorage

require vector_size 2048

require 64bit

statement ok
ATTACH '__TEST_DIR__/scan_json_vacuum_memory.db' AS db (ROW_GROUP_SIZE 8192)

statement ok
SET memory_limit='20GB';

statement ok
SET checkpoint_threshold='1TB';

statement ok
SET threads=1;

statement ok
CREATE TABLE db.t AS SELECT i AS id, to_json(CONCAT(lpad(i::VARCHAR, 10, '0'), repeat('x', 299988))) AS b FROM range(16384) tbl(i);

query I
SELECT type FROM pragma_table_info('db.t') WHERE name='b';
----
JSON

statement ok
SET GLOBAL scan_target_size_bytes=16777216;

statement ok
CHECKPOINT db;

query II
SELECT count(*), sum(length(b)) FROM db.t;
----
16384	4915200000

query I
SELECT count(DISTINCT row_group_id) FROM pragma_storage_info('db.t');
----
2

statement ok
DELETE FROM db.t WHERE (id % 8192) >= 2048;

query II
SELECT count(*), sum(id) FROM db.t;
----
4096	20969472

statement ok
SET GLOBAL scan_target_size_bytes=0;

statement ok
SET memory_limit='300MB';

statement error
CHECKPOINT db;
----
Out of Memory

restart

statement ok
ATTACH '__TEST_DIR__/scan_json_vacuum_memory.db' AS db (ROW_GROUP_SIZE 8192)

statement ok
SET memory_limit='20GB';

query II
SELECT count(*), sum(id) FROM db.t;
----
4096	20969472

statement ok
SET GLOBAL scan_target_size_bytes=16777216;

statement ok
SET memory_limit='300MB';

statement ok
CHECKPOINT db;

statement ok
SET memory_limit='20GB';

query II
SELECT count(*), sum(id) FROM db.t;
----
4096	20969472

query I
SELECT count(DISTINCT row_group_id) FROM pragma_storage_info('db.t');
----
1

restart

