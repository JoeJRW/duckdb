# name: test/sql/settings/scan_target_size_bytes_global.test
# description: The scan byte budget is global across connections and rejects session settings
# group: [settings]

require noforcestorage

statement ok
SET threads=1

statement ok
CREATE TABLE scan_budget AS SELECT i FROM range(4096) tbl(i)

query I other
SELECT current_setting('scan_target_size_bytes')
----
0

statement ok
SET GLOBAL scan_target_size_bytes=1024

query I other
SELECT current_setting('scan_target_size_bytes')
----
1024

query I
SELECT scope FROM duckdb_settings() WHERE name='scan_target_size_bytes'
----
GLOBAL

statement error
SET SESSION scan_target_size_bytes=0
----
can only be set globally

statement error
RESET SESSION scan_target_size_bytes
----
can only be set globally

query I
SELECT current_setting('scan_target_size_bytes')
----
1024

statement ok other
SET scan_target_size_bytes=257

query I
SELECT current_setting('scan_target_size_bytes')
----
257

statement ok
CALL enable_logging(level='trace')

query I
SELECT sum(i) FROM scan_budget
----
8386560

statement ok
SET enable_logging=false

query I
SELECT count(*) > 0 AND bool_and(message.split('target_bytes=')[2].split(' ')[1]::UBIGINT = 257) FROM duckdb_logs WHERE message.starts_with('ScanSizePredictor batch:')
----
true

statement ok other
RESET scan_target_size_bytes

query I
SELECT current_setting('scan_target_size_bytes')
----
0

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging(level='trace')

query I
SELECT sum(i) FROM scan_budget
----
8386560

statement ok
SET enable_logging=false

query I
SELECT count(*) FROM duckdb_logs WHERE message.starts_with('ScanSizePredictor batch:')
----
0

statement error
SET scan_target_size_bytes=-1
----
out of range

statement ok
SET scan_target_size_bytes=512

statement ok
RESET GLOBAL scan_target_size_bytes

query I other
SELECT current_setting('scan_target_size_bytes')
----
0
